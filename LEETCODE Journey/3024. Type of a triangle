class Solution:
    def triangleType(self, arr: List[int]) -> str:
        if (arr[0]+arr[1]>arr[2] and arr[2]+arr[1]>arr[0] and arr[0]+arr[2]>arr[1]):
            
            if (arr[0]==arr[1]==arr[2]):
                return "equilateral"
            elif (arr[0]==arr[1] or arr[1]==arr[2] or arr[0]==arr[2]):
                return "isosceles"
            else:
                return "scalene"        


        
        else:
            return "none"

        
